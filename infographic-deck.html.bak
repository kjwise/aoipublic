              <section class="col-span-1 md:col-span-12" data-infographic-section-id="i3-section-08-ouroboros-protocol" data-infographic-selector="main &gt; section:nth-of-type(6)" data-infographic-source="infographic-3.html" data-infographic-status="published" data-infographic-fragment-shell="1">
<span data-infographic-fragment-label="1" aria-hidden="true">i3-section-08-ouroboros-protocol</span>
<style>
  [data-role="ouroboros-sim"] {
    container-type: inline-size;
  }

  [data-role="ouroboros-sim"] .ouro-phase {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(11, 12, 16, 0.5);
    color: #b5b6bf;
    transition: all 180ms ease;
  }
  [data-role="ouroboros-sim"] .ouro-phase[data-active="1"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.14);
    color: #f2f3f8;
    box-shadow: 0 0 0 1px rgba(42, 195, 222, 0.2) inset;
  }
  [data-role="ouroboros-sim"] .attempt-pill.is-trip {
    background: rgba(187, 154, 247, 0.24);
    border-color: rgba(187, 154, 247, 0.34);
  }
  [data-role="ouroboros-sim"] .ouro-preset[data-active="1"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.16);
    color: #f2f3f8;
  }
  [data-role="ouroboros-sim"] .progress-pill {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.6rem;
    background: rgba(11, 12, 16, 0.46);
    padding: 0.4rem 0.45rem;
    min-width: 0;
  }
  [data-role="ouroboros-sim"] .progress-pill[data-state="pass"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.14);
  }
  [data-role="ouroboros-sim"] .progress-pill[data-state="escalate"] {
    border-color: rgba(187, 154, 247, 0.4);
    background: rgba(187, 154, 247, 0.16);
  }
  [data-role="ouroboros-sim"] .progress-pill[data-state="empty"] {
    opacity: 0.58;
    border-style: dashed;
  }
  [data-role="ouroboros-sim"] [data-role="progress-status"][data-state="improving"],
  [data-role="ouroboros-sim"] [data-role="progress-status"][data-state="converged"] {
    color: #2ac3de;
  }
  [data-role="ouroboros-sim"] [data-role="progress-status"][data-state="stalled"],
  [data-role="ouroboros-sim"] [data-role="progress-status"][data-state="unreachable"] {
    color: #bb9af7;
  }
  [data-role="ouroboros-sim"] [data-role="progress-status"][data-state="diverging"] {
    color: #f87171;
  }

  [data-role="ouroboros-sim"] .ouro-metric-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  [data-role="ouroboros-sim"] .ouro-metric-card {
    min-width: 0;
  }

  [data-role="ouroboros-sim"] .ouro-metric-copy {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @container (min-width: 32rem) {
    [data-role="ouroboros-sim"] .ouro-metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 56rem) {
    [data-role="ouroboros-sim"] .ouro-metric-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .content:not(.infographic-presentation)
    [data-infographic-section-id="i3-section-08-ouroboros-protocol"]
    [data-role="ouroboros-sim"] .ouro-metric-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
