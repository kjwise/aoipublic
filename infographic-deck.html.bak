      [data-infographic-section-id="i3-section-08-ouroboros-protocol"]
      [data-role="ouroboros-sim"] .ouro-metric-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-role="ouroboros-sim"] .ouro-phase {
      transition: none;
    }
  }
</style>
<div class="bg-brand-surface rounded-xl shadow-lg p-8 border border-brand-border border-l-8 border-l-brand-vibrant">
<div class="flex flex-col lg:flex-row gap-8">
<div class="lg:w-5/12">
<h2 class="text-3xl font-bold text-brand-strong mb-3">Ouroboros Protocol (Write → Judge → Refine)</h2>
<p class="text-brand-muted leading-relaxed">
        This is the control loop for iterative delivery: write a bounded candidate, judge it with deterministic gates,
        then refine only against the failure signal. Repeat until convergence or circuit-break.
      </p>
<div class="mt-5 bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Deterministic stop conditions</div>
<div class="text-sm text-brand-muted leading-relaxed">
<span class="block font-mono text-brand-vibrant">Write → Judge → Refine</span>
<span class="block mt-2">Stop on <span class="font-mono text-brand-strong">PASS</span> (converged) or on
          <span class="font-mono text-brand-strong">budget exhausted</span> (escalate).</span>
<span class="block mt-2">Judge can route to refine, rewrite, or re-scope before the next loop.</span>
</div>
</div>
</div>
<div class="lg:w-7/12 space-y-4" data-role="ouroboros-sim">
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-3">Interactive model</div>
<div class="grid grid-cols-1 md:grid-cols-12 gap-3">
<div class="md:col-span-6">
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Target quality</span>
<span class="font-mono text-brand-strong"><span data-role="target-value">86</span>/100</span>
</div>
<label class="sr-only" for="ouroTargetSlider">Target quality slider</label>
<input class="mt-2 w-full" data-role="target-slider" id="ouroTargetSlider" max="95" min="65" step="1" type="range" value="86"/>
</div>
<div class="md:col-span-6">
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Circuit breaker</span>
<span class="font-mono text-brand-strong"><span data-role="budget-value">8</span> loops</span>
</div>
<label class="sr-only" for="ouroBudgetSlider">Circuit breaker slider</label>
<input class="mt-2 w-full" data-role="budget-slider" id="ouroBudgetSlider" max="16" min="3" step="1" type="range" value="8"/>
</div>
<div class="md:col-span-6">
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Refinement strength</span>
<span class="font-mono text-brand-strong"><span data-role="refine-value">55</span>/100</span>
</div>
<label class="sr-only" for="ouroRefineSlider">Refinement strength slider</label>
<input class="mt-2 w-full" data-role="refine-slider" id="ouroRefineSlider" max="100" min="25" step="1" type="range" value="55"/>
</div>
<div class="md:col-span-6">
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Stochasticity</span>
<span class="font-mono text-brand-strong"><span data-role="noise-value">45</span>/100</span>
</div>
<label class="sr-only" for="ouroNoiseSlider">Stochasticity slider</label>
<input class="mt-2 w-full" data-role="noise-slider" id="ouroNoiseSlider" max="100" min="0" step="1" type="range" value="45"/>
</div>
</div>
<div class="mt-4">
<div class="text-xs font-mono text-brand-muted mb-2">Scenario presets</div>
<div class="flex flex-wrap gap-2">
<button class="soft-toggle font-mono ouro-preset" data-active="0" data-preset="converging" data-role="preset" type="button">Converging</button>
<button class="soft-toggle font-mono ouro-preset" data-active="0" data-preset="thrashing" data-role="preset" type="button">Thrashing</button>
<button class="soft-toggle font-mono ouro-preset" data-active="0" data-preset="no-attractor" data-role="preset" type="button">No Attractor</button>
</div>
<div class="mt-2 text-[11px] text-brand-muted" data-role="preset-note">Manual controls. Choose a preset to model a specific loop regime.</div>
</div>
<div class="mt-4 grid grid-cols-3 gap-2 text-xs font-mono">
<div class="ouro-phase rounded-lg p-2 text-center" data-active="0" data-phase="write" data-role="phase-pill">WRITE</div>
<div class="ouro-phase rounded-lg p-2 text-center" data-active="0" data-phase="judge" data-role="phase-pill">JUDGE</div>
<div class="ouro-phase rounded-lg p-2 text-center" data-active="0" data-phase="refine" data-role="phase-pill">REFINE</div>
</div>
<div class="mt-3 flex flex-wrap gap-2">
<button class="soft-toggle font-mono" data-role="step" type="button">Step Once</button>
<button class="soft-toggle font-mono" data-role="run" type="button">Run Loop</button>
<button class="soft-toggle font-mono" data-role="reset" type="button">Reset</button>
</div>
</div>
<div class="ouro-metric-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
<div class="ouro-metric-card bg-brand-light border border-brand-border rounded-xl p-3 min-w-0">
<div class="ouro-metric-copy text-xs font-mono text-brand-muted">Loop count</div>
<div class="ouro-metric-copy mt-1 text-base sm:text-lg leading-snug font-bold text-brand-strong"><span data-role="loop-count">0</span></div>
</div>
<div class="ouro-metric-card bg-brand-light border border-brand-border rounded-xl p-3 min-w-0">
<div class="ouro-metric-copy text-xs font-mono text-brand-muted">Current quality</div>
<div class="ouro-metric-copy mt-1 text-base sm:text-lg leading-snug font-bold text-brand-strong"><span data-role="quality">52</span>/100</div>
</div>
<div class="ouro-metric-card bg-brand-light border border-brand-border rounded-xl p-3 min-w-0">
<div class="ouro-metric-copy text-xs font-mono text-brand-muted">Open errors</div>
<div class="ouro-metric-copy mt-1 text-base sm:text-lg leading-snug font-bold text-brand-strong"><span data-role="errors">6</span></div>
</div>
<div class="ouro-metric-card bg-brand-light border border-brand-border rounded-xl p-3 min-w-0">
<div class="ouro-metric-copy text-xs font-mono text-brand-muted">Status</div>
<div class="ouro-metric-copy mt-1 text-base sm:text-lg leading-snug font-bold text-brand-strong" data-role="status">READY</div>
</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">Minimum progress window (W=4)</div>
<div class="text-xs text-brand-muted" data-role="progress-status" data-state="baseline">Collecting baseline.</div>
</div>
<div class="mt-2 grid grid-cols-2 sm:grid-cols-4 gap-2" data-role="progress-window"></div>
<div class="mt-2 text-[11px] text-brand-muted" data-role="signature-status">Run the loop to inspect error signatures.</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Structured error object</div>
<pre class="text-[11px] leading-relaxed font-mono text-brand-strong whitespace-pre-wrap" data-role="error-json"></pre>
<div class="mt-2 text-xs text-brand-muted" data-role="outcome">Ready. Run one bounded cycle.</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">Loop outcomes</div>
<div class="text-xs text-brand-muted">Cyan = PASS, red = refine, violet = escalate</div>
</div>
<div class="mt-3 grid grid-cols-12 gap-1" data-role="attempts"></div>
</div>
</div>
</div>
</div>
<script>
(function () {
  const script = document.currentScript;
  const root = script ? script.closest('[data-infographic-section-id="i3-section-08-ouroboros-protocol"]') : null;
  if (!root || root.dataset.ouroborosReady === "1") return;
  root.dataset.ouroborosReady = "1";

  const sim = root.querySelector('[data-role="ouroboros-sim"]');
  if (!sim) return;

  const targetSlider = sim.querySelector('[data-role="target-slider"]');
  const budgetSlider = sim.querySelector('[data-role="budget-slider"]');
  const refineSlider = sim.querySelector('[data-role="refine-slider"]');
  const noiseSlider = sim.querySelector('[data-role="noise-slider"]');
  const targetValue = sim.querySelector('[data-role="target-value"]');
  const budgetValue = sim.querySelector('[data-role="budget-value"]');
  const refineValue = sim.querySelector('[data-role="refine-value"]');
  const noiseValue = sim.querySelector('[data-role="noise-value"]');
  const loopCountEl = sim.querySelector('[data-role="loop-count"]');
  const qualityEl = sim.querySelector('[data-role="quality"]');
  const errorsEl = sim.querySelector('[data-role="errors"]');
  const statusEl = sim.querySelector('[data-role="status"]');
  const errorJsonEl = sim.querySelector('[data-role="error-json"]');
  const outcomeEl = sim.querySelector('[data-role="outcome"]');
  const attemptsEl = sim.querySelector('[data-role="attempts"]');
  const presetButtons = Array.from(sim.querySelectorAll('[data-role="preset"]'));
  const presetNoteEl = sim.querySelector('[data-role="preset-note"]');
  const progressStatusEl = sim.querySelector('[data-role="progress-status"]');
  const progressWindowEl = sim.querySelector('[data-role="progress-window"]');
  const signatureStatusEl = sim.querySelector('[data-role="signature-status"]');
  const phasePills = Array.from(sim.querySelectorAll('[data-role="phase-pill"]'));
  const stepBtn = sim.querySelector('[data-role="step"]');
  const runBtn = sim.querySelector('[data-role="run"]');
  const resetBtn = sim.querySelector('[data-role="reset"]');

  if (!targetSlider || !budgetSlider || !refineSlider || !noiseSlider || !targetValue || !budgetValue || !refineValue || !noiseValue ||
      !loopCountEl || !qualityEl || !errorsEl || !statusEl || !errorJsonEl || !outcomeEl || !attemptsEl ||
      !stepBtn || !runBtn || !resetBtn || !presetNoteEl || !progressStatusEl || !progressWindowEl || !signatureStatusEl ||
      phasePills.length === 0 || presetButtons.length === 0) return;

  const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
  const toInt = (v, fallback) => {
    const n = Number.parseInt(String(v), 10);
    return Number.isFinite(n) ? n : fallback;
  };
  const randSigned = () => (Math.random() * 2) - 1;
  const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phaseDelay = reducedMotion ? 0 : 140;
  const loopDelay = reducedMotion ? 0 : 220;
  const PRESETS = {
    converging: {
      target: 80,
      budget: 10,
      refine: 82,
      noise: 18,
      quality: 58,
      errors: 6,
      scenario: "normal",
      note: "Low stochasticity + strong refine. Deficit should shrink within W attempts."
    },
    thrashing: {
      target: 92,
      budget: 8,
      refine: 36,
      noise: 78,
      quality: 50,
      errors: 6,
      scenario: "normal",
      note: "High stochasticity + weaker refine. Expect churn and repeated signatures."
    },
    "no-attractor": {
      target: 90,
      budget: 6,
      refine: 42,
      noise: 55,
      quality: 60,
      errors: 3,
      scenario: "no-attractor",
      note: "Contradictory constraints. PASS is unreachable; loop should escalate."
    }
  };

  const state = {
    target: toInt(targetSlider.value, 86),
    budget: toInt(budgetSlider.value, 8),
    refine: toInt(refineSlider.value, 55),
    noise: toInt(noiseSlider.value, 45),
    preset: "custom",
    scenario: "normal",
    initialQuality: 52,
    initialErrors: 6,
    loop: 0,
    quality: 52,
    errors: 6,
    status: "READY",
    running: false,
    animating: false,
    failStreak: 0,
    progressWindowSize: 4,
    history: [],
    lastSignal: {
      run: 0,
      code: "ready",
      gate: "quality_floor",
      expected: "score >= 86 and errors <= 1",
      actual: "score=34, errors=6",
      deficit: 52,
      next_action: "write"
    }
  };

  const setPhase = (name) => {
    for (const pill of phasePills) {
      pill.dataset.active = pill.dataset.phase === name ? "1" : "0";
    }
  };

  const clearPhases = () => setPhase("");
  const scoreFor = (quality, errors) => Math.round(quality - (errors * 3));
  const deficitFor = (score) => Math.max(0, state.target - score);
  const currentPreset = () => PRESETS[state.preset] || null;
  const setCustomScenario = () => {
    state.preset = "custom";
    state.scenario = "normal";
    state.initialQuality = 52;
    state.initialErrors = 6;
  };
  const signatureFor = (deficit, errors, code) => {
    const deficitBucket = Math.ceil(deficit / 4);
    return `${code}:${deficitBucket}:${errors}`;
  };

  const appendAttempt = (kind) => {
    const pill = document.createElement("span");
    const suffix = kind === "pass" ? "is-pass" : kind === "escalate" ? "is-trip" : "is-fail";
    pill.className = `attempt-pill ${suffix}`;
    attemptsEl.appendChild(pill);
    while (attemptsEl.children.length > 36) {
      attemptsEl.removeChild(attemptsEl.firstChild);
    }
  };

  const pushHistory = (entry) => {
    state.history.push(entry);
    while (state.history.length > 24) {
      state.history.shift();
    }
  };

  const resetRunState = () => {
    stopRun();
    state.loop = 0;
    state.quality = clamp(Math.round(state.initialQuality), 0, 100);
    state.errors = clamp(Math.round(state.initialErrors), 0, 12);
    state.status = "READY";
    state.failStreak = 0;
    state.history = [];
    const baselineScore = scoreFor(state.quality, state.errors);
    state.lastSignal = {
      run: 0,
      code: "ready",
      gate: state.scenario === "no-attractor" ? "attractor" : "quality_floor",
      expected: state.scenario === "no-attractor" ? "admissible(candidate) is unreachable under current constraints" : `score >= ${state.target} and errors <= 1`,
      actual: `score=${baselineScore}, errors=${state.errors}`,
      deficit: deficitFor(baselineScore),
      next_action: "write"
    };
    attemptsEl.innerHTML = "";
    clearPhases();
    render();
  };

  const applyPreset = (presetKey) => {
    const preset = PRESETS[presetKey];
    if (!preset) return;
    state.preset = presetKey;
    state.scenario = preset.scenario;
    state.target = preset.target;
    state.budget = preset.budget;
    state.refine = preset.refine;
    state.noise = preset.noise;
    state.initialQuality = preset.quality;
    state.initialErrors = preset.errors;
    resetRunState();
  };

  const renderProgress = () => {
    const windowItems = state.history.slice(-state.progressWindowSize);
    progressWindowEl.innerHTML = "";

    for (const item of windowItems) {
      const pill = document.createElement("div");
      pill.className = "progress-pill";
      pill.dataset.state = item.status === "PASS" ? "pass" : item.status === "ESCALATE" ? "escalate" : "iterating";
      const runLabel = document.createElement("div");
      runLabel.className = "text-[10px] font-mono text-brand-muted";
      runLabel.textContent = `#${item.run}`;
      const signal = document.createElement("div");
      signal.className = "mt-1 text-[11px] font-mono text-brand-strong";
      signal.textContent = `d${item.deficit} · e${item.errors}`;
      pill.appendChild(runLabel);
      pill.appendChild(signal);
      progressWindowEl.appendChild(pill);
    }

    for (let i = windowItems.length; i < state.progressWindowSize; i += 1) {
      const empty = document.createElement("div");
      empty.className = "progress-pill";
      empty.dataset.state = "empty";
      const emptyRun = document.createElement("div");
      emptyRun.className = "text-[10px] font-mono text-brand-muted";
      emptyRun.textContent = "—";
      const emptySignal = document.createElement("div");
      emptySignal.className = "mt-1 text-[11px] font-mono text-brand-muted";
      emptySignal.textContent = "d? · e?";
      empty.appendChild(emptyRun);
      empty.appendChild(emptySignal);
      progressWindowEl.appendChild(empty);
    }

    if (windowItems.length === 0) {
      progressStatusEl.dataset.state = "baseline";
      progressStatusEl.textContent = "Collecting baseline.";
      signatureStatusEl.textContent = "Run the loop to inspect error signatures.";
      return;
    }

    const first = windowItems[0];
    const last = windowItems[windowItems.length - 1];
    const deficitDelta = last.deficit - first.deficit;
    const errorDelta = last.errors - first.errors;
    const signatureCount = new Set(windowItems.map((item) => item.signature)).size;
    const repeated = signatureCount < windowItems.length;

    let progressState = "baseline";
    let progressText = "Collecting baseline.";

    if (last.status === "PASS") {
      progressState = "converged";
      progressText = "Converged: attractor reached.";
    } else if (state.scenario === "no-attractor") {
      progressState = "unreachable";
      progressText = "Unreachable attractor: retries cannot produce PASS.";
    } else if (windowItems.length < 2) {
      progressState = "baseline";
      progressText = "Collecting baseline.";
    } else if (deficitDelta <= -3 || (deficitDelta <= 0 && errorDelta < 0)) {
      progressState = "improving";
      progressText = "Improving: deficit trend is shrinking.";
    } else if (repeated && windowItems.length >= 3) {
      progressState = "stalled";
      progressText = "Stalled: failure signature is repeating.";
    } else if (deficitDelta >= 3 || errorDelta > 1) {
      progressState = "diverging";
      progressText = "Diverging: distance to target is increasing.";
    } else {
      progressState = "baseline";
      progressText = "Mixed signal: not yet monotonic.";
    }

    progressStatusEl.dataset.state = progressState;
    progressStatusEl.textContent = progressText;
    if (state.scenario === "no-attractor") {
      signatureStatusEl.textContent = "Reachability failure: tighten conflicting constraints or re-scope mission.";
    } else if (repeated) {
      signatureStatusEl.textContent = "Signature repeat detected. Consider re-scope or tighter constraints.";
    } else {
      signatureStatusEl.textContent = "Signature variation present. Continue until monotonic progress or escalate.";
    }
  };

  const render = () => {
    targetSlider.value = String(state.target);
    budgetSlider.value = String(state.budget);
    refineSlider.value = String(state.refine);
    noiseSlider.value = String(state.noise);
    targetValue.textContent = String(state.target);
    budgetValue.textContent = String(state.budget);
    refineValue.textContent = String(state.refine);
    noiseValue.textContent = String(state.noise);
    loopCountEl.textContent = String(state.loop);
    qualityEl.textContent = String(state.quality);
    errorsEl.textContent = String(state.errors);

    for (const button of presetButtons) {
      button.dataset.active = button.dataset.preset === state.preset ? "1" : "0";
    }
    const preset = currentPreset();
    presetNoteEl.textContent = preset ? preset.note : "Manual controls. Choose a preset to model a specific loop regime.";

    let statusColor = "#b5b6bf";
    if (state.status === "PASS") statusColor = "#2ac3de";
    if (state.status === "ESCALATE") statusColor = "#bb9af7";
    if (state.status === "ITERATING") statusColor = "#f2f3f8";
    statusEl.textContent = state.status;
    statusEl.style.color = statusColor;

    errorJsonEl.textContent = JSON.stringify(state.lastSignal, null, 2);

    if (state.status === "PASS") {
      outcomeEl.textContent = "PASS: converged under deterministic gates.";
    } else if (state.status === "ESCALATE") {
      if (state.scenario === "no-attractor") {
        outcomeEl.textContent = `CIRCUIT BREAK: no reachable attractor under current constraints. Escalate with evidence.`;
      } else {
        outcomeEl.textContent = `CIRCUIT BREAK: loop budget (${state.budget}) exhausted. Escalate with evidence.`;
      }
    } else if (state.status === "ITERATING") {
      const nextAction = state.lastSignal.next_action || "refine";
      if (nextAction === "rewrite") {
        outcomeEl.textContent = "Judge selected rewrite: regenerate candidate with adjusted context.";
      } else if (nextAction === "re-scope") {
        outcomeEl.textContent = "Judge selected re-scope: tighten mission boundaries before next write.";
      } else {
        outcomeEl.textContent = "Judge selected refine: targeted mutation from the failure signal.";
      }
    } else {
      outcomeEl.textContent = "Ready. Run one bounded cycle.";
    }

    runBtn.textContent = state.running ? "Stop" : "Run Loop";
    renderProgress();
  };

  const pickDecision = (choices) => {
    const stochastic = state.noise / 100;
    if (stochastic < 0.08) {
      return choices.reduce((best, item) => (item.weight > best.weight ? item : best), choices[0]).action;
    }
    const total = choices.reduce((sum, item) => sum + Math.max(0, item.weight), 0);
    const r = Math.random() * (total || 1);
    let cursor = 0;
    for (const item of choices) {
      cursor += Math.max(0, item.weight);
      if (r <= cursor) return item.action;
    }
    return choices[choices.length - 1].action;
  };

  const evaluateCycle = () => {
    const cycle = state.loop + 1;
    const deficit = Math.max(0, state.target - state.quality);
    const noiseScale = state.noise / 100;
    const writeGain = clamp(
      Math.round(deficit * (0.10 + state.refine / 250) + (randSigned() * 6 * noiseScale)),
      -2,
      18
    );
    const candidateQuality = clamp(state.quality + writeGain, 0, 100);
    const errorNoise = Math.random() < (0.14 + (noiseScale * 0.18)) ? 1 : 0;
    const candidateErrors = clamp(
      state.errors - Math.max(0, Math.floor((writeGain + 1) / 4)) + errorNoise,
      0,
      12
    );
    const gateScore = candidateQuality - (candidateErrors * 3) + (randSigned() * 7 * noiseScale);
    const attractorReachable = state.scenario !== "no-attractor";
    const pass = attractorReachable && gateScore >= state.target && candidateErrors <= 1;
    const budgetHit = cycle >= state.budget;

    let nextQuality = candidateQuality;
    let nextErrors = candidateErrors;
    let nextStatus = pass ? "PASS" : (budgetHit ? "ESCALATE" : "ITERATING");
    let nextAction = pass ? "accept" : (budgetHit ? "escalate" : "refine");
    let showRefinePhase = false;

    if (pass) {
      state.failStreak = 0;
    } else {
      state.failStreak += 1;
    }

    if (!pass && !budgetHit) {
      if (!attractorReachable) {
        nextAction = "re-scope";
        nextQuality = clamp(candidateQuality + Math.max(0, Math.round(deficit * 0.04)), 0, 100);
        nextErrors = Math.max(0, candidateErrors - (Math.random() < 0.20 ? 1 : 0));
      } else {
        const refineBoost = Math.max(1, Math.round((state.refine - 35) / 18));
        const deficitNow = Math.max(0, state.target - gateScore);
        const decision = pickDecision([
          { action: "refine", weight: clamp(0.38 + (state.refine / 240) + (deficitNow / 280), 0.2, 0.8) },
          { action: "rewrite", weight: clamp(0.26 + (state.noise / 260) + (state.failStreak / 35), 0.12, 0.65) },
          { action: "re-scope", weight: clamp(0.20 + ((100 - state.refine) / 420), 0.06, 0.42) }
        ]);

        nextAction = decision;
        if (decision === "refine") {
          nextQuality = clamp(candidateQuality + refineBoost + (randSigned() * 3 * noiseScale), 0, 100);
          nextErrors = Math.max(0, candidateErrors - 1);
          showRefinePhase = true;
        } else if (decision === "rewrite") {
          nextQuality = clamp(candidateQuality - 1 + (randSigned() * 4 * noiseScale), 0, 100);
          nextErrors = clamp(candidateErrors + (Math.random() < (0.20 + 0.25 * noiseScale) ? 1 : 0), 0, 12);
        } else {
          nextQuality = clamp(state.quality + Math.max(0, Math.round(deficit * 0.05 + (randSigned() * 2 * noiseScale))), 0, 100);
          nextErrors = Math.max(0, state.errors - (Math.random() < 0.35 ? 1 : 0));
        }
      }
    }

    state.loop = cycle;
    state.quality = clamp(Math.round(nextQuality), 0, 100);
    state.errors = clamp(Math.round(nextErrors), 0, 12);
    state.status = nextStatus;
    const scored = Math.round(gateScore);
    const runDeficit = attractorReachable ? deficitFor(scored) : Math.max(1, deficitFor(scored));
    const failureCode = pass ? "pass" : (!attractorReachable ? "unreachable_constraints" : "validator_fail");
    state.lastSignal = {
      run: state.loop,
      code: failureCode,
      gate: attractorReachable ? "quality_floor" : "attractor",
      expected: attractorReachable ? `score >= ${state.target} and errors <= 1` : "admissible(candidate) is unreachable under current constraints",
      actual: attractorReachable ? `score=${scored}, errors=${candidateErrors}` : `attractor_unreachable, score=${scored}, errors=${candidateErrors}`,
      deficit: runDeficit,
      next_action: nextAction
    };
    pushHistory({
      run: state.loop,
      deficit: runDeficit,
      errors: state.errors,
      status: state.status,
      signature: signatureFor(runDeficit, state.errors, failureCode)
    });

    appendAttempt(pass ? "pass" : (nextStatus === "ESCALATE" ? "escalate" : "fail"));
    render();
    return { action: nextAction, showRefinePhase };
  };

  const runAnimatedCycle = (done) => {
    if (state.animating) {
      if (done) done();
      return;
    }
    if (state.status === "PASS" || state.status === "ESCALATE") {
      if (done) done();
      return;
    }
    state.animating = true;
    setPhase("write");
    window.setTimeout(() => {
      setPhase("judge");
      window.setTimeout(() => {
        const result = evaluateCycle() || {};
        if (result.showRefinePhase) {
          setPhase("refine");
          window.setTimeout(() => {
            clearPhases();
            state.animating = false;
            if (done) done();
          }, phaseDelay);
          return;
        }
        clearPhases();
        state.animating = false;
        if (done) done();
      }, phaseDelay);
    }, phaseDelay);
  };

  const stopRun = () => {
    state.running = false;
    render();
  };

  const runLoop = () => {
    if (state.running) {
      stopRun();
      return;
    }
    if (state.status === "PASS" || state.status === "ESCALATE") return;
    state.running = true;
    render();

    const tick = () => {
      if (!state.running) return;
      runAnimatedCycle(() => {
        if (state.status === "PASS" || state.status === "ESCALATE") {
          stopRun();
          return;
        }
        window.setTimeout(tick, loopDelay);
      });
    };
    tick();
  };

  targetSlider.addEventListener("input", () => {
    setCustomScenario();
    state.target = toInt(targetSlider.value, state.target);
    state.lastSignal.expected = `score >= ${state.target} and errors <= 1`;
    render();
  });
  budgetSlider.addEventListener("input", () => {
    setCustomScenario();
    state.budget = toInt(budgetSlider.value, state.budget);
    render();
  });
  refineSlider.addEventListener("input", () => {
    setCustomScenario();
    state.refine = toInt(refineSlider.value, state.refine);
    render();
  });
  noiseSlider.addEventListener("input", () => {
    setCustomScenario();
    state.noise = toInt(noiseSlider.value, state.noise);
    render();
  });
  for (const presetButton of presetButtons) {
    presetButton.addEventListener("click", () => {
      applyPreset(presetButton.dataset.preset || "");
    });
  }

  stepBtn.addEventListener("click", () => {
    if (state.running || state.animating) return;
    runAnimatedCycle();
  });
  runBtn.addEventListener("click", runLoop);
  resetBtn.addEventListener("click", () => {
    const preset = currentPreset();
    if (preset) {
      state.target = preset.target;
      state.budget = preset.budget;
      state.refine = preset.refine;
      state.noise = preset.noise;
      state.initialQuality = preset.quality;
      state.initialErrors = preset.errors;
      state.scenario = preset.scenario;
    }
    resetRunState();
  });

  render();
})();
</script>
</section>

            </section><section class="infographic-slide" data-infographic-section-id="i3-section-07-ratchet-gates" aria-label="Ratchets (Quality Floors That Only Move Up)" data-slide-index="21" role="group">
              <div class="infographic-slide__header">
                <span class="infographic-slide__title">Ratchets (Quality Floors That Only Move Up)</span>
                <span class="infographic-slide__meta">i3-section-07-ratchet-gates</span>
              </div>
              <section class="col-span-1 md:col-span-12" data-infographic-section-id="i3-section-07-ratchet-gates" data-infographic-selector="main &gt; section:nth-of-type(7)" data-infographic-source="infographic-3.html" data-infographic-status="published" data-infographic-fragment-shell="1">
<span data-infographic-fragment-label="1" aria-hidden="true">i3-section-07-ratchet-gates</span>
<style>
  [data-role="ratchet-sim"] .ratchet-phase {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(11, 12, 16, 0.48);
    color: #b5b6bf;
    transition: all 180ms ease;
  }
  [data-role="ratchet-sim"] .ratchet-phase[data-active="1"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.14);
    color: #f2f3f8;
    box-shadow: 0 0 0 1px rgba(42, 195, 222, 0.2) inset;
  }
  [data-role="ratchet-sim"] .soft-toggle[data-role="scenario"][aria-pressed="true"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.16);
    color: #f2f3f8;
  }
  [data-role="ratchet-sim"] .attempt-pill.is-human {
    background: rgba(187, 154, 247, 0.24);
    border-color: rgba(187, 154, 247, 0.34);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-role="ratchet-sim"] .ratchet-phase {
      transition: none;
    }
  }
</style>
<div class="bg-brand-surface rounded-xl shadow-lg p-8 border border-brand-border border-l-8 border-l-brand-vibrant">
<div class="flex flex-col lg:flex-row gap-8">
<div class="lg:w-5/12">
<h2 class="text-3xl font-bold text-brand-strong mb-3">Ratchets (Quality Floors That Only Move Up)</h2>
<p class="text-brand-muted leading-relaxed">
      Ratchets turn quality expectations into executable law. A candidate can fail, but the floor does not move down.
      If a candidate passes deterministic guards, the floor moves up and future loops start from a stronger baseline.
    </p>
<div class="mt-5 bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Atomic admission loop</div>
<div class="text-sm text-brand-muted leading-relaxed space-y-2">
<span class="block"><span class="font-mono text-brand-vibrant">1) Measure</span> baseline metrics.</span>
<span class="block"><span class="font-mono text-brand-vibrant">2) Mutate</span> one bounded candidate.</span>
<span class="block"><span class="font-mono text-brand-vibrant">3) Validate</span> ratchets + policy gates.</span>
<span class="block"><span class="font-mono text-brand-vibrant">4) Decide</span> raise floor, reject, or route to human gate.</span>
</div>
</div>
<div class="mt-4 bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Deterministic guard rules</div>
<div class="text-sm text-brand-muted leading-relaxed">
<span class="block font-mono text-brand-vibrant">test_count_new &gt;= test_count_old</span>
<span class="block font-mono text-brand-vibrant mt-1">coverage_new &gt;= coverage_old</span>
<span class="block font-mono text-brand-vibrant mt-1">lint_new &lt;= lint_old</span>
<span class="block font-mono text-brand-vibrant mt-1">security_new &lt;= security_old</span>
<span class="block mt-2">If all ratchets pass, policy decides: allowlisted auto-merge or explicit human approval.</span>
</div>
</div>
</div>
<div class="lg:w-7/12 space-y-4" data-role="ratchet-sim">
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-3">Scenario runner (deterministic)</div>
<div class="flex flex-wrap gap-2" data-role="scenario-controls">
<button aria-pressed="true" class="soft-toggle font-mono" data-role="scenario" data-scenario="lint_fix" type="button">Lint Autofix</button>
<button aria-pressed="false" class="soft-toggle font-mono" data-role="scenario" data-scenario="coverage_drop" type="button">Coverage Drop</button>
<button aria-pressed="false" class="soft-toggle font-mono" data-role="scenario" data-scenario="security_regression" type="button">Security Regression</button>
<button aria-pressed="false" class="soft-toggle font-mono" data-role="scenario" data-scenario="api_expansion" type="button">API Expansion</button>
</div>
<div class="mt-2 text-xs text-brand-muted" data-role="scenario-note">Small bounded mutation that should raise quality and pass ratchets.</div>
<div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono">
<div class="ratchet-phase rounded-lg p-2 text-center" data-active="0" data-phase="measure" data-role="phase-pill">1 Measure</div>
<div class="ratchet-phase rounded-lg p-2 text-center" data-active="0" data-phase="mutate" data-role="phase-pill">2 Mutate</div>
<div class="ratchet-phase rounded-lg p-2 text-center" data-active="0" data-phase="validate" data-role="phase-pill">3 Validate</div>
<div class="ratchet-phase rounded-lg p-2 text-center" data-active="0" data-phase="decide" data-role="phase-pill">4 Decide</div>
</div>
<div class="mt-3 flex flex-wrap gap-2">
<button class="soft-toggle font-mono" data-role="run" type="button">Run Scenario</button>
<button class="soft-toggle font-mono" data-role="reset" type="button">Reset Floor</button>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Test count</div>
<div class="mt-1 text-sm sm:text-base font-bold text-brand-strong"><span data-role="test-old">480</span> -&gt; <span data-role="test-new">481</span></div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Coverage</div>
<div class="mt-1 text-sm sm:text-base font-bold text-brand-strong"><span data-role="coverage-old">88.0</span>% -&gt; <span data-role="coverage-new">88.0</span>%</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Lint violations</div>
<div class="mt-1 text-sm sm:text-base font-bold text-brand-strong"><span data-role="lint-old">6</span> -&gt; <span data-role="lint-new">4</span></div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Security findings</div>
<div class="mt-1 text-sm sm:text-base font-bold text-brand-strong"><span data-role="security-old">2</span> -&gt; <span data-role="security-new">2</span></div>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Current floor</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span data-role="floor">72</span>/100</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Candidate quality</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span data-role="candidate-quality">75</span>/100</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Ratchet gate</div>
<div class="mt-1 text-lg font-bold text-brand-strong" data-role="status">READY</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Decision</div>
<div class="mt-1 text-sm sm:text-base font-bold text-brand-strong" data-role="decision">Run scenario</div>
</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted mb-2">Gate trace</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 text-xs text-brand-muted">
<div class="border border-brand-border rounded-lg p-2">test_count: <span data-role="check-test">READY</span></div>
<div class="border border-brand-border rounded-lg p-2">coverage: <span data-role="check-coverage">READY</span></div>
<div class="border border-brand-border rounded-lg p-2">lint: <span data-role="check-lint">READY</span></div>
<div class="border border-brand-border rounded-lg p-2">security: <span data-role="check-security">READY</span></div>
<div class="border border-brand-border rounded-lg p-2">quality floor: <span data-role="check-quality">READY</span></div>
<div class="border border-brand-border rounded-lg p-2">policy gate: <span data-role="check-policy">READY</span></div>
</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Floor vs candidate</div>
<div class="space-y-2">
<div>
<div class="text-xs text-brand-muted mb-1">Floor</div>
<div class="h-2 rounded-full bg-brand-dark/70 border border-brand-border overflow-hidden">
<div class="h-full bg-brand-primary" data-role="floor-bar" style="width: 72%;"></div>
</div>
</div>
<div>
<div class="text-xs text-brand-muted mb-1">Candidate</div>
<div class="h-2 rounded-full bg-brand-dark/70 border border-brand-border overflow-hidden">
<div class="h-full bg-brand-accent" data-role="candidate-bar" style="width: 75%;"></div>
</div>
</div>
</div>
<div class="mt-3 text-xs text-brand-muted" data-role="outcome">Ready. Run a candidate through deterministic guards.</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">Attempts</div>
<div class="text-xs text-brand-muted">Cyan = floor raised, red = rejected, violet = human gate</div>
</div>
<div class="mt-3 grid grid-cols-12 gap-1" data-role="attempts"></div>
</div>
</div>
</div>
</div>
<script>
(function () {
  const script = document.currentScript;
  const root = script ? script.closest('[data-infographic-section-id="i3-section-07-ratchet-gates"]') : null;
  if (!root || root.dataset.ratchetReady === "1") return;
  root.dataset.ratchetReady = "1";

  const sim = root.querySelector('[data-role="ratchet-sim"]');
  if (!sim) return;

  const scenarioButtons = Array.from(sim.querySelectorAll('[data-role="scenario"]'));
  const scenarioNoteEl = sim.querySelector('[data-role="scenario-note"]');
  const phasePills = Array.from(sim.querySelectorAll('[data-role="phase-pill"]'));
  const runBtn = sim.querySelector('[data-role="run"]');
  const resetBtn = sim.querySelector('[data-role="reset"]');

  const testOldEl = sim.querySelector('[data-role="test-old"]');
  const testNewEl = sim.querySelector('[data-role="test-new"]');
  const coverageOldEl = sim.querySelector('[data-role="coverage-old"]');
  const coverageNewEl = sim.querySelector('[data-role="coverage-new"]');
  const lintOldEl = sim.querySelector('[data-role="lint-old"]');
  const lintNewEl = sim.querySelector('[data-role="lint-new"]');
  const securityOldEl = sim.querySelector('[data-role="security-old"]');
  const securityNewEl = sim.querySelector('[data-role="security-new"]');

  const floorEl = sim.querySelector('[data-role="floor"]');
  const candidateQualityEl = sim.querySelector('[data-role="candidate-quality"]');
  const statusEl = sim.querySelector('[data-role="status"]');
  const decisionEl = sim.querySelector('[data-role="decision"]');

  const checkTestEl = sim.querySelector('[data-role="check-test"]');
  const checkCoverageEl = sim.querySelector('[data-role="check-coverage"]');
  const checkLintEl = sim.querySelector('[data-role="check-lint"]');
  const checkSecurityEl = sim.querySelector('[data-role="check-security"]');
  const checkQualityEl = sim.querySelector('[data-role="check-quality"]');
  const checkPolicyEl = sim.querySelector('[data-role="check-policy"]');

  const floorBar = sim.querySelector('[data-role="floor-bar"]');
  const candidateBar = sim.querySelector('[data-role="candidate-bar"]');
  const outcomeEl = sim.querySelector('[data-role="outcome"]');
  const attemptsEl = sim.querySelector('[data-role="attempts"]');

  if (!scenarioNoteEl || !runBtn || !resetBtn || phasePills.length === 0 || scenarioButtons.length === 0 ||
      !testOldEl || !testNewEl || !coverageOldEl || !coverageNewEl || !lintOldEl || !lintNewEl ||
      !securityOldEl || !securityNewEl || !floorEl || !candidateQualityEl || !statusEl || !decisionEl ||
      !checkTestEl || !checkCoverageEl || !checkLintEl || !checkSecurityEl || !checkQualityEl || !checkPolicyEl ||
      !floorBar || !candidateBar || !outcomeEl || !attemptsEl) return;

  const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
  const round = (n) => Math.round(n);
  const round1 = (n) => Math.round(n * 10) / 10;
  const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));
  const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phaseDelay = reducedMotion ? 0 : 130;

  const SCENARIOS = {
    lint_fix: {
      note: 'Small bounded mutation that should raise quality and pass ratchets.',
      delta: { test: 1, coverage: 0.0, lint: -2, security: 0 },
      requiresHuman: false,
    },
    coverage_drop: {
      note: 'Refactor reduces measured coverage below the existing floor.',
      delta: { test: 0, coverage: -1.8, lint: -1, security: 0 },
      requiresHuman: false,
    },
    security_regression: {
      note: 'Candidate introduces a new security finding. Deterministic reject.',
      delta: { test: 1, coverage: 0.0, lint: 0, security: 1 },
      requiresHuman: false,
    },
    api_expansion: {
      note: 'Quality improves, but API surface expansion requires explicit human approval.',
      delta: { test: 2, coverage: 0.2, lint: -1, security: 0 },
      requiresHuman: true,
    },
  };

  const INITIAL_BASELINE = { test: 480, coverage: 88.0, lint: 6, security: 2 };

  const state = {
    selected: 'lint_fix',
    baseline: { ...INITIAL_BASELINE },
    floor: 72,
    running: false,
  };

  const qualityScore = (metrics) => {
    const score = 72
      + (metrics.coverage - 88) * 1.9
      + (metrics.test - 480) * 0.2
      - (metrics.lint - 6) * 1.4
      - (metrics.security - 2) * 4.5;
    return clamp(round(score), 0, 100);
  };

  const formatCoverage = (n) => round1(n).toFixed(1);

  const deriveCandidate = (baseline, scenario) => ({
    test: Math.max(0, baseline.test + scenario.delta.test),
    coverage: clamp(round1(baseline.coverage + scenario.delta.coverage), 0, 100),
    lint: Math.max(0, baseline.lint + scenario.delta.lint),
    security: Math.max(0, baseline.security + scenario.delta.security),
  });

  const evaluate = (baseline, candidate, scenario) => {
    const checks = {
      test: candidate.test >= baseline.test,
      coverage: (candidate.coverage + 0.1) >= baseline.coverage,
      lint: candidate.lint <= baseline.lint,
      security: candidate.security <= baseline.security,
    };

    const candidateQuality = qualityScore(candidate);
    const qualityPass = candidateQuality >= state.floor;
    const ratchetPass = checks.test && checks.coverage && checks.lint && checks.security && qualityPass;

    const failures = [];
    if (!checks.test) failures.push(`test_count ${candidate.test} < ${baseline.test}`);
    if (!checks.coverage) failures.push(`coverage ${formatCoverage(candidate.coverage)} < ${formatCoverage(baseline.coverage)}`);
    if (!checks.lint) failures.push(`lint ${candidate.lint} > ${baseline.lint}`);
    if (!checks.security) failures.push(`security ${candidate.security} > ${baseline.security}`);
    if (!qualityPass) failures.push(`quality ${candidateQuality} < floor ${state.floor}`);

    let verdict = 'FAIL';
    let decision = 'REVERT';
    let pillClass = 'is-fail';
    let policyGate = 'BLOCKED';

    if (ratchetPass && scenario.requiresHuman) {
      verdict = 'HUMAN GATE';
      decision = 'WAIT FOR APPROVAL';
      pillClass = 'is-human';
      policyGate = 'HUMAN';
    } else if (ratchetPass) {
      verdict = 'PASS';
      decision = 'RAISE FLOOR';
      pillClass = 'is-pass';
      policyGate = 'ALLOWLISTED';
    }

    return {
      checks,
      qualityPass,
      candidateQuality,
      ratchetPass,
      failures,
      verdict,
      decision,
      pillClass,
      policyGate,
    };
  };

  const setPhase = (phase) => {
    for (const pill of phasePills) {
      const active = pill.dataset.phase === phase;
      pill.dataset.active = active ? '1' : '0';
    }
  };

  const clearPhase = () => {
    for (const pill of phasePills) {
      pill.dataset.active = '0';
    }
  };

  const updateCheck = (el, value, tone) => {
    el.textContent = value;
    if (tone === 'pass') el.style.color = '#2ac3de';
    else if (tone === 'fail') el.style.color = '#f7768e';
    else if (tone === 'human') el.style.color = '#bb9af7';
    else el.style.color = '#b5b6bf';
  };

  const updateScenarioButtons = () => {
    for (const button of scenarioButtons) {
      const active = button.dataset.scenario === state.selected;
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    }
  };

  const appendAttempt = (pillClass) => {
    const pill = document.createElement('span');
    pill.className = `attempt-pill ${pillClass}`;
    attemptsEl.appendChild(pill);
    while (attemptsEl.children.length > 36) {
      attemptsEl.removeChild(attemptsEl.firstChild);
    }
  };

  const render = (baseline, candidate, evaluation, mode, oldFloor) => {
    const scenario = SCENARIOS[state.selected];

    scenarioNoteEl.textContent = scenario.note;
    testOldEl.textContent = String(baseline.test);
    testNewEl.textContent = String(candidate.test);
    coverageOldEl.textContent = formatCoverage(baseline.coverage);
    coverageNewEl.textContent = formatCoverage(candidate.coverage);
    lintOldEl.textContent = String(baseline.lint);
    lintNewEl.textContent = String(candidate.lint);
    securityOldEl.textContent = String(baseline.security);
    securityNewEl.textContent = String(candidate.security);

    floorEl.textContent = String(state.floor);
    candidateQualityEl.textContent = String(evaluation.candidateQuality);
    floorBar.style.width = `${state.floor}%`;
    candidateBar.style.width = `${evaluation.candidateQuality}%`;

    if (mode === 'preview') {
      statusEl.textContent = 'READY';
      statusEl.style.color = '#b5b6bf';
      decisionEl.textContent = `Predicted: ${evaluation.decision}`;
      decisionEl.style.color = '#b5b6bf';
      outcomeEl.textContent = 'Ready. Run a candidate through deterministic guards.';
    } else {
      statusEl.textContent = evaluation.verdict;
      statusEl.style.color = evaluation.verdict === 'PASS' ? '#2ac3de' : (evaluation.verdict === 'HUMAN GATE' ? '#bb9af7' : '#f7768e');
      decisionEl.textContent = evaluation.decision;
      decisionEl.style.color = statusEl.style.color;

      if (evaluation.verdict === 'PASS') {
        outcomeEl.textContent = `PASS: floor raised from ${oldFloor} to ${state.floor}.`;
      } else if (evaluation.verdict === 'HUMAN GATE') {
        outcomeEl.textContent = `HUMAN GATE: ratchets pass at ${evaluation.candidateQuality}, but policy requires approval.`;
      } else {
        outcomeEl.textContent = `FAIL: ${evaluation.failures.join('; ')}. Floor stays ${state.floor}.`;
      }
    }

    updateCheck(checkTestEl, evaluation.checks.test ? 'PASS' : 'FAIL', evaluation.checks.test ? 'pass' : 'fail');
    updateCheck(checkCoverageEl, evaluation.checks.coverage ? 'PASS' : 'FAIL', evaluation.checks.coverage ? 'pass' : 'fail');
    updateCheck(checkLintEl, evaluation.checks.lint ? 'PASS' : 'FAIL', evaluation.checks.lint ? 'pass' : 'fail');
    updateCheck(checkSecurityEl, evaluation.checks.security ? 'PASS' : 'FAIL', evaluation.checks.security ? 'pass' : 'fail');
    updateCheck(checkQualityEl, evaluation.qualityPass ? 'PASS' : 'FAIL', evaluation.qualityPass ? 'pass' : 'fail');

    if (evaluation.policyGate === 'ALLOWLISTED') {
      updateCheck(checkPolicyEl, 'ALLOWLISTED', 'pass');
    } else if (evaluation.policyGate === 'HUMAN') {
      updateCheck(checkPolicyEl, 'HUMAN REVIEW', 'human');
    } else {
      updateCheck(checkPolicyEl, 'BLOCKED', mode === 'preview' ? 'neutral' : 'fail');
    }
  };

  const renderPreview = () => {
    const scenario = SCENARIOS[state.selected];
    const baseline = { ...state.baseline };
    const candidate = deriveCandidate(baseline, scenario);
    const evaluation = evaluate(baseline, candidate, scenario);
    render(baseline, candidate, evaluation, 'preview', state.floor);
    clearPhase();
  };

  const runScenario = async () => {
    if (state.running) return;
    state.running = true;
    runBtn.disabled = true;
    resetBtn.disabled = true;

    const phases = ['measure', 'mutate', 'validate', 'decide'];
    for (const phase of phases) {
      setPhase(phase);
      if (phaseDelay > 0) await wait(phaseDelay);
    }

    const scenario = SCENARIOS[state.selected];
    const baselineBefore = { ...state.baseline };
    const oldFloor = state.floor;
    const candidate = deriveCandidate(baselineBefore, scenario);
    const evaluation = evaluate(baselineBefore, candidate, scenario);

    if (evaluation.verdict === 'PASS') {
      state.baseline = { ...candidate };
      state.floor = evaluation.candidateQuality;
    }

    appendAttempt(evaluation.pillClass);
    render(baselineBefore, candidate, evaluation, 'result', oldFloor);

    state.running = false;
    runBtn.disabled = false;
    resetBtn.disabled = false;
  };

  for (const button of scenarioButtons) {
    button.addEventListener('click', () => {
      if (state.running) return;
      const key = button.dataset.scenario;
      if (!key || !SCENARIOS[key]) return;
      state.selected = key;
      updateScenarioButtons();
      renderPreview();
    });
  }

  runBtn.addEventListener('click', runScenario);

  resetBtn.addEventListener('click', () => {
    if (state.running) return;
    state.baseline = { ...INITIAL_BASELINE };
    state.floor = qualityScore(state.baseline);
    attemptsEl.innerHTML = '';
    statusEl.textContent = 'READY';
    statusEl.style.color = '#b5b6bf';
    decisionEl.textContent = 'Run scenario';
    decisionEl.style.color = '#b5b6bf';
    outcomeEl.textContent = 'Reset. Floor returned to baseline.';
    clearPhase();
    renderPreview();
  });

  state.floor = qualityScore(state.baseline);
  updateScenarioButtons();
  renderPreview();
})();
</script>
</section>

            </section><section class="infographic-slide" data-infographic-section-id="i3-section-05-always-on-loops" aria-label="Always-On Loops (Maintenance That Compounds)" data-slide-index="22" role="group">
              <div class="infographic-slide__header">
                <span class="infographic-slide__title">Always-On Loops (Maintenance That Compounds)</span>
                <span class="infographic-slide__meta">i3-section-05-always-on-loops</span>
              </div>
              <section class="col-span-1 md:col-span-12" data-infographic-section-id="i3-section-05-always-on-loops" data-infographic-selector="main &gt; section:nth-of-type(8)" data-infographic-source="infographic-3.html" data-infographic-status="published" data-infographic-fragment-shell="1">
<span data-infographic-fragment-label="1" aria-hidden="true">i3-section-05-always-on-loops</span>
<style>
  [data-infographic-section-id="i3-section-05-always-on-loops"] .maint-trend-pill {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.6rem;
    background: rgba(11, 12, 16, 0.48);
    padding: 0.45rem;
    min-width: 0;
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] .maint-trend-pill[data-state="pass"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.14);
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] .maint-trend-pill[data-state="defer"] {
    border-color: rgba(255, 158, 100, 0.42);
    background: rgba(255, 158, 100, 0.14);
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] .maint-trend-pill[data-state="fail"] {
    border-color: rgba(247, 118, 142, 0.45);
    background: rgba(247, 118, 142, 0.16);
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] .maint-trend-pill[data-state="empty"] {
    opacity: 0.56;
    border-style: dashed;
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] [data-role="maint-trend-status"][data-state="converged"],
  [data-infographic-section-id="i3-section-05-always-on-loops"] [data-role="maint-trend-status"][data-state="improving"] {
    color: #2ac3de;
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] [data-role="maint-trend-status"][data-state="defer"] {
    color: #ff9e64;
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] [data-role="maint-trend-status"][data-state="flat"] {
    color: #bb9af7;
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] [data-role="maint-trend-status"][data-state="unreachable"] {
    color: #f7768e;
  }

  [data-infographic-section-id="i3-section-05-always-on-loops"] #maintReceipt {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>
<div class="bg-brand-surface rounded-xl shadow-lg p-8 border border-brand-border border-l-8 border-l-brand-primary">
<div class="flex flex-col lg:flex-row gap-8">
<div class="lg:w-5/12">
<h2 class="text-3xl font-bold text-brand-strong mb-3">Always-On Loops (Maintenance That Compounds)</h2>
<p class="text-brand-muted leading-relaxed">
              A Dream Daemon is not a cron job. It is a bounded control loop that senses entropy,
              ranks one target, and exits with a deterministic decision: PASS, DEFER, or ESCALATE.
            </p>
<div class="mt-5 bg-brand-light border border-brand-border rounded-xl p-4 space-y-4">
<div>
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Timeline</span>
<span class="font-mono text-brand-strong">Week <span id="maintWeekValue">8</span>/26</span>
</div>
<label class="sr-only" for="maintWeekSlider">Week slider</label>
<input class="mt-2 w-full" id="maintWeekSlider" max="26" min="0" type="range" value="8"/>
</div>
<div>
<div class="text-xs font-mono text-brand-muted mb-2">Active loops</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
<button aria-pressed="true" class="soft-toggle font-mono" data-maint-loop="map" type="button">Map updater</button>
<button aria-pressed="false" class="soft-toggle font-mono" data-maint-loop="dream" type="button">Dream daemon</button>
<button aria-pressed="true" class="soft-toggle font-mono" data-maint-loop="refactor" type="button">Refactor under guards</button>
<button aria-pressed="true" class="soft-toggle font-mono" data-maint-loop="governance" type="button">Governance</button>
<button aria-pressed="false" class="soft-toggle font-mono sm:col-span-2" data-maint-loop="hedged" type="button">Hedged compute</button>
</div>
</div>
<div>
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Cycle budget</span>
<span class="font-mono text-brand-strong"><span id="maintCycleBudgetValue">6</span>x</span>
</div>
<label class="sr-only" for="maintCycleBudgetSlider">Cycle budget slider</label>
<input class="mt-2 w-full" id="maintCycleBudgetSlider" max="12" min="2" step="1" type="range" value="6"/>
</div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
<button class="soft-toggle font-mono" id="maintRunCycleButton" type="button">Run cycle</button>
<button class="soft-toggle font-mono" id="maintRunToGateButton" type="button">Run to gate</button>
<button class="soft-toggle font-mono" id="maintResetButton" type="button">Reset</button>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
<div class="bg-brand-surface border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Entropy debt</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span id="maintDebt">—</span>/100</div>
</div>
<div class="bg-brand-surface border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Incidents</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span id="maintIncidents">—</span>/wk</div>
</div>
<div class="bg-brand-surface border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">P95 cost/outcome</div>
<div class="mt-1 text-lg font-bold text-brand-danger"><span id="maintP95">—</span></div>
</div>
<div class="bg-brand-surface border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Budget remaining</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span id="maintBudgetRemaining">6</span>x</div>
</div>
<div class="bg-brand-surface border border-brand-border rounded-xl p-3 sm:col-span-2 xl:col-span-2">
<div class="text-xs font-mono text-brand-muted">Selected target</div>
<div class="mt-1 text-sm font-semibold text-brand-strong" id="maintTarget">—</div>
<div class="mt-1 text-xs text-brand-muted">Expected gain: <span class="font-mono text-brand-strong" id="maintExpectedGain">—</span></div>
</div>
</div>
</div>
<div class="mt-4 text-xs text-brand-muted leading-relaxed">
              The chart shows long-horizon trajectory. The controls below model the bounded execution loop:
              one target per cycle, hard budget, and deterministic admission gates.
            </div>
</div>
<div class="lg:w-7/12 space-y-4">
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="chart-container">
<canvas id="maintenanceChart"></canvas>
</div>
<p class="text-xs text-center text-brand-muted mt-2">
                Debt (left axis) vs P95 cost/outcome (right axis). The dashed marker tracks the selected week.
              </p>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-3">
<div class="lg:col-span-6 bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Constraint → deterministic gate</div>
<div class="mt-2 space-y-2 text-sm text-brand-muted">
<div class="flex items-center justify-between gap-2">
<span>Signal ranker improves debt trajectory</span>
<span class="font-mono text-brand-strong" id="maintGateSignal">PENDING</span>
</div>
<div class="flex items-center justify-between gap-2">
<span>Guardrails active (map + governance)</span>
<span class="font-mono text-brand-strong" id="maintGateGuardrails">PASS</span>
</div>
<div class="flex items-center justify-between gap-2">
<span>Cycle budget not exhausted</span>
<span class="font-mono text-brand-strong" id="maintGateBudget">PASS</span>
</div>
<div class="flex items-center justify-between gap-2">
<span>Receipt written to Ledger</span>
<span class="font-mono text-brand-strong" id="maintGateLedger">PENDING</span>
</div>
</div>
</div>
<div class="lg:col-span-6 bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Daemon state of record</div>
<div class="mt-2 text-sm text-brand-muted leading-relaxed">
<div class="flex items-center justify-between gap-2">
<span>Status</span>
<span class="font-mono text-brand-strong" id="maintStatus">READY</span>
</div>
<div class="mt-2 flex items-center justify-between gap-2">
<span>Cycle</span>
<span class="font-mono text-brand-strong" id="maintCycle">0/6</span>
</div>
<div class="mt-2 flex items-center justify-between gap-2">
<span>Last run</span>
<span class="font-mono text-brand-strong" id="maintLastRun">--</span>
</div>
</div>
<div class="mt-3 text-xs font-mono text-brand-muted" id="maintReceipt">ledger/dream-daemon/week-08/cycle-00.json</div>
</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">Minimum progress window (W=4)</div>
<div class="text-xs text-brand-muted" data-role="maint-trend-status" id="maintTrendStatus" data-state="baseline">Collecting baseline.</div>
</div>
<div class="mt-2 grid grid-cols-2 sm:grid-cols-4 gap-2" id="maintTrendWindow"></div>
<div class="mt-2 text-xs text-brand-muted" id="maintOutcome">Ready to run one bounded cycle.</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">Cycle outcomes</div>
<div class="text-xs text-brand-muted">Cyan = PASS, amber = DEFER, violet = ESCALATE</div>
</div>
<div class="mt-3 flex flex-wrap gap-1" id="maintAttempts"></div>
</div>
</div>
</div>
</div>
</section>

            </section><section class="infographic-slide" data-infographic-section-id="i3-section-09-sensor-measurement" aria-label="Sensor Hierarchy (UML-Style)" data-slide-index="23" role="group">
              <div class="infographic-slide__header">
                <span class="infographic-slide__title">Sensor Hierarchy (UML-Style)</span>
                <span class="infographic-slide__meta">i3-section-09-sensor-measurement</span>
              </div>
              <section class="col-span-1 md:col-span-12" data-infographic-section-id="i3-section-09-sensor-measurement" data-infographic-selector="main &gt; section:nth-of-type(9)" data-infographic-source="infographic-3.html" data-infographic-status="published" data-infographic-fragment-shell="1">
<span data-infographic-fragment-label="1" aria-hidden="true">i3-section-09-sensor-measurement</span>
<style>
  [data-role="sensor-uml"] .uml-card {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(11, 12, 16, 0.55);
    border-radius: 0.75rem;
    padding: 0.7rem;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }
  [data-role="sensor-uml"] .uml-card[data-active="1"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.12);
    box-shadow: 0 0 0 1px rgba(42, 195, 222, 0.18) inset;
  }
  [data-role="sensor-uml"] .uml-inherit {
    width: 2px;
    height: 18px;
    margin: 0.2rem auto;
    background: linear-gradient(180deg, rgba(122, 162, 247, 0.55), rgba(42, 195, 222, 0.55));
  }
  [data-role="sensor-uml"] .uml-arrow {
    width: 0;
    height: 0;
    margin: 0 auto;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 8px solid rgba(42, 195, 222, 0.75);
  }
  [data-role="sensor-uml"] .sensor-event.is-emit {
    background: rgba(122, 162, 247, 0.24);
    border-color: rgba(122, 162, 247, 0.34);
  }
  [data-role="sensor-uml"] .sensor-event.is-blocked {
    background: rgba(247, 118, 142, 0.22);
    border-color: rgba(247, 118, 142, 0.34);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-role="sensor-uml"] .uml-card {
      transition: none;
    }
  }
</style>
<div class="bg-brand-surface rounded-xl shadow-lg p-8 border border-brand-border border-l-8 border-l-brand-vibrant">
<div class="flex flex-col lg:flex-row gap-8">
<div class="lg:w-5/12">
<h2 class="text-3xl font-bold text-brand-strong mb-3">Sensor Hierarchy (UML-Style)</h2>
<p class="text-brand-muted leading-relaxed">
        Treat Sensor as a base interface, then specialize by terrain surface. Different sensors emit
        different signal shapes, cadences, and confidence profiles.
      </p>
<div class="mt-5 bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Base contract</div>
<div class="text-sm text-brand-muted leading-relaxed">
<span class="block font-mono text-brand-vibrant">class Sensor</span>
<span class="block mt-1 font-mono">+ read(): Signal</span>
<span class="block font-mono">+ descriptor(): SensorDescriptor</span>
<span class="block font-mono">+ mode: READ_ONLY</span>
<span class="block mt-2">Judge consumes the emitted signal; Effectors own mutation.</span>
</div>
</div>
</div>
<div class="lg:w-7/12 space-y-4" data-role="sensor-uml">
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-3">Interactive model</div>
<div class="uml-card" data-active="1" data-role="base-class">
<div class="text-xs font-mono text-brand-muted">Base Class</div>
<div class="mt-1 text-sm font-bold text-brand-strong">Sensor</div>
<div class="mt-2 text-[11px] font-mono text-brand-muted">read() | descriptor() | mode=READ_ONLY</div>
</div>
<div class="uml-inherit"></div>
<div class="uml-arrow"></div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3" data-role="sensor-class-grid">
<button aria-pressed="true" class="uml-card text-left" data-active="1" data-role="sensor-class" data-sensor-id="ast" type="button">
<div class="text-xs font-mono text-brand-muted">Derived</div>
<div class="mt-1 text-sm font-semibold text-brand-strong">ASTSensor</div>
<div class="mt-1 text-[11px] font-mono text-brand-muted">Source structure</div>
</button>
<button aria-pressed="false" class="uml-card text-left" data-active="0" data-role="sensor-class" data-sensor-id="contract" type="button">
<div class="text-xs font-mono text-brand-muted">Derived</div>
<div class="mt-1 text-sm font-semibold text-brand-strong">ContractSensor</div>
<div class="mt-1 text-[11px] font-mono text-brand-muted">APIs + schemas</div>
</button>
<button aria-pressed="false" class="uml-card text-left" data-active="0" data-role="sensor-class" data-sensor-id="runtime" type="button">
<div class="text-xs font-mono text-brand-muted">Derived</div>
<div class="mt-1 text-sm font-semibold text-brand-strong">RuntimeSensor</div>
<div class="mt-1 text-[11px] font-mono text-brand-muted">Latency + faults</div>
</button>
<button aria-pressed="false" class="uml-card text-left" data-active="0" data-role="sensor-class" data-sensor-id="economic" type="button">
<div class="text-xs font-mono text-brand-muted">Derived</div>
<div class="mt-1 text-sm font-semibold text-brand-strong">EconomicSensor</div>
<div class="mt-1 text-[11px] font-mono text-brand-muted">Cost + utilization</div>
</button>
</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="grid grid-cols-1 md:grid-cols-12 gap-3">
<div class="md:col-span-6">
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Environment volatility</span>
<span class="font-mono text-brand-strong"><span data-role="volatility-value">34</span>/100</span>
</div>
<label class="sr-only" for="sensorVolatilitySlider">Volatility slider</label>
<input class="mt-2 w-full" data-role="volatility-slider" id="sensorVolatilitySlider" max="95" min="0" step="1" type="range" value="34"/>
</div>
<div class="md:col-span-6">
<div class="text-xs font-mono text-brand-muted mb-2">Sensor bundle</div>
<div class="grid grid-cols-2 gap-2 text-xs text-brand-muted" data-role="bundle-boxes">
<label class="inline-flex items-center gap-2"><input checked="" data-role="bundle-item" data-sensor-id="ast" type="checkbox"/>AST</label>
<label class="inline-flex items-center gap-2"><input checked="" data-role="bundle-item" data-sensor-id="contract" type="checkbox"/>Contract</label>
<label class="inline-flex items-center gap-2"><input data-role="bundle-item" data-sensor-id="runtime" type="checkbox"/>Runtime</label>
<label class="inline-flex items-center gap-2"><input data-role="bundle-item" data-sensor-id="economic" type="checkbox"/>Economic</label>
</div>
</div>
</div>
<div class="mt-3 flex flex-wrap gap-2">
<button class="soft-toggle font-mono" data-role="emit" type="button">Emit Bundle Signal</button>
<button class="soft-toggle font-mono" data-role="write-attempt" type="button">Attempt Write</button>
<button class="soft-toggle font-mono" data-role="reset" type="button">Reset</button>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Active sensors</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span data-role="active-count">2</span></div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Coverage</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span data-role="coverage">0</span>%</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Blind spots</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span data-role="blind">0</span></div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Signal confidence</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span data-role="confidence">0</span>/100</div>
</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Selected sensor descriptor</div>
<pre class="text-[11px] leading-relaxed font-mono text-brand-strong whitespace-pre-wrap" data-role="descriptor-json"></pre>
<div class="mt-3 text-xs font-mono text-brand-muted mb-2">Emitted bundle signal</div>
<pre class="text-[11px] leading-relaxed font-mono text-brand-strong whitespace-pre-wrap" data-role="signal-json"></pre>
<div class="mt-2 text-xs text-brand-muted" data-role="outcome">Select a class and emit a bundle signal.</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">Event stream</div>
<div class="text-xs text-brand-muted">Blue = emit, red = blocked write</div>
</div>
<div class="mt-3 grid grid-cols-12 gap-1" data-role="events"></div>
</div>
</div>
</div>
</div>
<script>
(function () {
  const script = document.currentScript;
  const root = script ? script.closest('[data-infographic-section-id="i3-section-09-sensor-measurement"]') : null;
  if (!root || root.dataset.sensorUmlReady === "1") return;
  root.dataset.sensorUmlReady = "1";

  const sim = root.querySelector('[data-role="sensor-uml"]');
  if (!sim) return;

  const classButtons = Array.from(sim.querySelectorAll('[data-role="sensor-class"]'));
  const bundleItems = Array.from(sim.querySelectorAll('[data-role="bundle-item"]'));
  const volatilitySlider = sim.querySelector('[data-role="volatility-slider"]');
  const volatilityValue = sim.querySelector('[data-role="volatility-value"]');
  const emitBtn = sim.querySelector('[data-role="emit"]');
  const writeBtn = sim.querySelector('[data-role="write-attempt"]');
  const resetBtn = sim.querySelector('[data-role="reset"]');
  const activeCountEl = sim.querySelector('[data-role="active-count"]');
  const coverageEl = sim.querySelector('[data-role="coverage"]');
  const blindEl = sim.querySelector('[data-role="blind"]');
  const confidenceEl = sim.querySelector('[data-role="confidence"]');
  const descriptorJsonEl = sim.querySelector('[data-role="descriptor-json"]');
  const signalJsonEl = sim.querySelector('[data-role="signal-json"]');
  const outcomeEl = sim.querySelector('[data-role="outcome"]');
  const eventsEl = sim.querySelector('[data-role="events"]');

  if (!classButtons.length || !bundleItems.length || !volatilitySlider || !volatilityValue ||
      !emitBtn || !writeBtn || !resetBtn || !activeCountEl || !coverageEl || !blindEl ||
      !confidenceEl || !descriptorJsonEl || !signalJsonEl || !outcomeEl || !eventsEl) return;

  const SENSOR_TYPES = {
    ast: {
      class_name: "ASTSensor",
      surface: "source tree + syntax graph",
      cadence: "per commit",
      emits: ["symbol_delta", "route_delta", "schema_refs"],
      base_quality: 82,
      coverage_weight: 26
    },
    contract: {
      class_name: "ContractSensor",
      surface: "openapi + schema contracts",
      cadence: "per pull request",
      emits: ["breaking_change_risk", "contract_mismatch", "boundary_drift"],
      base_quality: 84,
      coverage_weight: 30
    },
    runtime: {
      class_name: "RuntimeSensor",
      surface: "latency, errors, saturation",
      cadence: "continuous windows",
      emits: ["p95_shift", "incident_rate", "hot_path_regression"],
      base_quality: 76,
      coverage_weight: 24
    },
    economic: {
      class_name: "EconomicSensor",
      surface: "cost, retries, compute mix",
      cadence: "hourly batch",
      emits: ["cost_per_outcome", "retry_amplification", "capacity_pressure"],
      base_quality: 72,
      coverage_weight: 20
    }
  };

  const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
  const toInt = (v, fallback) => {
    const n = Number.parseInt(String(v), 10);
    return Number.isFinite(n) ? n : fallback;
  };
  const randSigned = () => (Math.random() * 2) - 1;

  const state = {
    run: 0,
    selected: "ast",
    volatility: toInt(volatilitySlider.value, 34),
    signal: { run: 0, action: "idle" }
  };

  const selectedBundle = () =>
    bundleItems
      .filter((item) => item.checked)
      .map((item) => item.dataset.sensorId || "")
      .filter((id) => Boolean(SENSOR_TYPES[id]));

  const appendEvent = (kind) => {
    const pill = document.createElement("span");
    pill.className = `attempt-pill sensor-event ${kind === "emit" ? "is-emit" : "is-blocked"}`;
    eventsEl.appendChild(pill);
    while (eventsEl.children.length > 36) {
      eventsEl.removeChild(eventsEl.firstChild);
    }
  };

  const renderSelection = () => {
    for (const btn of classButtons) {
      const active = (btn.dataset.sensorId || "") === state.selected;
      btn.dataset.active = active ? "1" : "0";
      btn.setAttribute("aria-pressed", active ? "true" : "false");
    }
    const d = SENSOR_TYPES[state.selected] || SENSOR_TYPES.ast;
    descriptorJsonEl.textContent = JSON.stringify({
      base_class: "Sensor",
      class_name: d.class_name,
      mode: "READ_ONLY",
      surface: d.surface,
      cadence: d.cadence,
      emits: d.emits
    }, null, 2);
  };

  const renderMetrics = (bundle, emitted) => {
    const sensors = bundle.length ? bundle : [state.selected];
    const overlapPenalty = Math.max(0, sensors.length - 2) * 4;
    const coverageBase = sensors.reduce((sum, id) => sum + (SENSOR_TYPES[id]?.coverage_weight || 0), 0);
    const coverage = clamp(Math.round(coverageBase - overlapPenalty - (state.volatility * 0.08)), 8, 100);
    const blind = clamp(Math.round(18 - sensors.length * 3 + (state.volatility * 0.09)), 0, 28);
    const qualityBase = sensors.reduce((sum, id) => sum + (SENSOR_TYPES[id]?.base_quality || 0), 0) / sensors.length;
    const noise = emitted ? randSigned() * 8 : 0;
    const confidence = clamp(Math.round(qualityBase - (state.volatility * 0.35) - (blind * 0.6) + noise), 5, 99);

    activeCountEl.textContent = String(sensors.length);
    coverageEl.textContent = String(coverage);
    blindEl.textContent = String(blind);
    confidenceEl.textContent = String(confidence);

    return { sensors, coverage, blind, confidence };
  };

  const render = () => {
    volatilityValue.textContent = String(state.volatility);
    renderSelection();
    renderMetrics(selectedBundle(), false);
    signalJsonEl.textContent = JSON.stringify(state.signal, null, 2);
  };

  const emitSignal = () => {
    state.run += 1;
    const bundle = selectedBundle();
    const metrics = renderMetrics(bundle, true);
    const quality = metrics.confidence;
    const next = quality >= 70 && metrics.blind <= 8 ? "judge-ready" : "add-sensor-or-tighten-physics";

    state.signal = {
      run: state.run,
      base_class: "Sensor",
      mode: "READ_ONLY",
      bundle: metrics.sensors.map((id) => SENSOR_TYPES[id].class_name),
      volatility: state.volatility,
      coverage: metrics.coverage,
      blind_spots: metrics.blind,
      confidence: quality,
      next_action: next
    };

    appendEvent("emit");
    outcomeEl.textContent = `Signal emitted from ${metrics.sensors.length} sensors. Next: ${next.replace(/-/g, " ")}.`;
    render();
  };

  const attemptWrite = () => {
    state.run += 1;
    state.signal = {
      run: state.run,
      base_class: "Sensor",
      mode: "READ_ONLY",
      action: "write_attempt",
      result: "blocked",
      reason: "sensor boundary violation",
      next_action: "route mutation to effector"
    };
    appendEvent("blocked");
    outcomeEl.textContent = "WRITE BLOCKED: only Effectors mutate Terrain.";
    render();
  };

  for (const btn of classButtons) {
    btn.addEventListener("click", () => {
      state.selected = btn.dataset.sensorId || "ast";
      render();
    });
  }
  for (const box of bundleItems) {
    box.addEventListener("change", () => {
      render();
    });
  }
  volatilitySlider.addEventListener("input", () => {
    state.volatility = toInt(volatilitySlider.value, state.volatility);
    render();
  });
  emitBtn.addEventListener("click", emitSignal);
  writeBtn.addEventListener("click", attemptWrite);
  resetBtn.addEventListener("click", () => {
    state.run = 0;
    state.selected = "ast";
    state.volatility = toInt(volatilitySlider.value, 34);
    for (const box of bundleItems) {
      const id = box.dataset.sensorId || "";
      box.checked = id === "ast" || id === "contract";
    }
    eventsEl.innerHTML = "";
    state.signal = { run: 0, action: "idle" };
    outcomeEl.textContent = "Select a class and emit a bundle signal.";
    render();
  });

  render();
})();
</script>
</section>

            </section><section class="infographic-slide" data-infographic-section-id="i3-section-10-agent-execution-envelope" aria-label="Agent (Constrained Execution Envelope)" data-slide-index="24" role="group">
              <div class="infographic-slide__header">
                <span class="infographic-slide__title">Agent (Constrained Execution Envelope)</span>
                <span class="infographic-slide__meta">i3-section-10-agent-execution-envelope</span>
              </div>
              <section class="col-span-1 md:col-span-12" data-infographic-section-id="i3-section-10-agent-execution-envelope" data-infographic-selector="main &gt; section:nth-of-type(10)" data-infographic-source="infographic-3.html" data-infographic-status="published" data-infographic-fragment-shell="1">
<span data-infographic-fragment-label="1" aria-hidden="true">i3-section-10-agent-execution-envelope</span>
<style>
  [data-role="agent-sim"] .gate-pill {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(11, 12, 16, 0.55);
    color: #b5b6bf;
    border-radius: 0.65rem;
    padding: 0.45rem 0.55rem;
    font-size: 0.72rem;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  [data-role="agent-sim"] .gate-pill.is-pass {
    border-color: rgba(42, 195, 222, 0.42);
    background: rgba(42, 195, 222, 0.12);
    color: #f2f3f8;
  }
  [data-role="agent-sim"] .gate-pill.is-fail {
    border-color: rgba(247, 118, 142, 0.4);
    background: rgba(247, 118, 142, 0.13);
    color: #f2f3f8;
  }
  [data-role="agent-sim"] .phase-pill {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(11, 12, 16, 0.5);
    color: #b5b6bf;
    transition: all 180ms ease;
  }
  [data-role="agent-sim"] .phase-pill[data-active="1"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.14);
    color: #f2f3f8;
  }
  [data-role="agent-sim"] .soft-toggle[data-role="case"][aria-pressed="true"] {
    border-color: rgba(42, 195, 222, 0.45);
    background: rgba(42, 195, 222, 0.16);
    color: #f2f3f8;
  }
  [data-role="agent-sim"] .attempt-pill.is-escalate {
    background: rgba(187, 154, 247, 0.24);
    border-color: rgba(187, 154, 247, 0.34);
  }
  [data-role="agent-sim"] .attempt-pill.is-warn {
    background: rgba(250, 204, 21, 0.24);
    border-color: rgba(250, 204, 21, 0.34);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-role="agent-sim"] .soft-toggle,
    [data-role="agent-sim"] .phase-pill {
      transition: none;
    }
  }
</style>
<div class="bg-brand-surface rounded-xl shadow-lg p-6 md:p-7 border border-brand-border border-l-8 border-l-brand-vibrant">
<div class="flex flex-col lg:flex-row gap-6">
<div class="lg:w-5/12 min-w-0">
<h2 class="text-3xl font-bold text-brand-strong mb-3">Governance Envelope (Policy + Evidence)</h2>
<p class="text-brand-muted leading-relaxed">
      Governance at machine speed means deterministic policy outcomes for every candidate diff.
      The model proposes; policy decides; the ledger records why.
    </p>
<div class="mt-5 bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Execution path</div>
<div class="text-sm text-brand-muted leading-relaxed">
<span class="block font-mono text-brand-vibrant">Mission -&gt; Policy Validators -&gt; Decision -&gt; Ledger Event</span>
<span class="block mt-2">Outcomes are explicit: <span class="font-mono">allow</span>, <span class="font-mono">block</span>, <span class="font-mono">escalate</span>, or <span class="font-mono">warn (time-bounded exception)</span>.</span>
<span class="block mt-2">Policy precedence resolves conflicts: <span class="font-mono">security &gt; scope &gt; architecture &gt; style</span>.</span>
</div>
</div>
<div class="mt-4 bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-2">Core deterministic checks</div>
<div class="text-sm text-brand-muted leading-relaxed">
<span class="block font-mono text-brand-vibrant">scope_guard(paths) = PASS|FAIL</span>
<span class="block font-mono text-brand-vibrant mt-1">secrets_scan(diff) = PASS|FAIL</span>
<span class="block font-mono text-brand-vibrant mt-1">dynamic_exec_scan(diff) = PASS|FAIL</span>
<span class="block font-mono text-brand-vibrant mt-1">architecture_guard(diff) = PASS|ESCALATE</span>
</div>
</div>
</div>
<div class="lg:w-7/12 min-w-0 space-y-4" data-role="agent-sim">
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="text-xs font-mono text-brand-muted mb-3">Deterministic scenario runner</div>
<div class="flex flex-wrap gap-2" data-role="case-controls">
<button aria-pressed="true" class="soft-toggle font-mono" data-case="allowlisted_refactor" data-role="case" type="button">Allowlisted Refactor</button>
<button aria-pressed="false" class="soft-toggle font-mono" data-case="protected_path_touch" data-role="case" type="button">Protected Path Touch</button>
<button aria-pressed="false" class="soft-toggle font-mono" data-case="hardcoded_secret" data-role="case" type="button">Hardcoded Secret</button>
<button aria-pressed="false" class="soft-toggle font-mono" data-case="architecture_change" data-role="case" type="button">Architecture Change</button>
</div>
<div class="mt-2 text-xs text-brand-muted" data-role="case-note">Low-risk refactor inside allowlisted scope.</div>
<div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono">
<div class="phase-pill rounded-lg p-2 text-center" data-active="0" data-phase="compile" data-role="phase-pill">1 Compile</div>
<div class="phase-pill rounded-lg p-2 text-center" data-active="0" data-phase="evaluate" data-role="phase-pill">2 Evaluate</div>
<div class="phase-pill rounded-lg p-2 text-center" data-active="0" data-phase="decide" data-role="phase-pill">3 Decide</div>
<div class="phase-pill rounded-lg p-2 text-center" data-active="0" data-phase="record" data-role="phase-pill">4 Record</div>
</div>
<div class="mt-3 grid grid-cols-1 md:grid-cols-12 gap-3">
<div class="md:col-span-6">
<div class="flex items-center justify-between text-xs text-brand-muted">
<span class="font-mono">Exception TTL</span>
<span class="font-mono text-brand-strong"><span data-role="ttl-value">7</span> days</span>
</div>
<label class="sr-only" for="agentExceptionTtl">Exception time-to-live in days</label>
<input class="mt-2 w-full" data-role="ttl-slider" id="agentExceptionTtl" max="30" min="1" step="1" type="range" value="7"/>
</div>
<div class="md:col-span-6 text-xs text-brand-muted flex items-end">
<div><span class="font-mono">Exception state:</span> <span data-role="exception-state">none</span></div>
</div>
</div>
<div class="mt-3 flex flex-wrap gap-2">
<button class="soft-toggle font-mono" data-role="evaluate" type="button">Evaluate Request</button>
<button class="soft-toggle font-mono" data-role="exception" type="button">Request Exception</button>
<button class="soft-toggle font-mono" data-role="reset" type="button">Reset</button>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Selected case</div>
<div class="mt-1 text-sm font-bold text-brand-strong" data-role="selected-label">Allowlisted Refactor</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Verdict</div>
<div class="mt-1 text-lg font-bold text-brand-strong" data-role="verdict">READY</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Policy action</div>
<div class="mt-1 text-sm font-bold text-brand-strong" data-role="action">Predicted: execute</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="text-xs font-mono text-brand-muted">Ledger run</div>
<div class="mt-1 text-lg font-bold text-brand-strong"><span data-role="run">0</span></div>
</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-4">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">Gate decisions</div>
<div class="text-xs text-brand-muted">precedence hit: <span data-role="precedence">none</span></div>
</div>
<div class="mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
<div class="gate-pill" data-role="gate-scope">scope_guard: -</div>
<div class="gate-pill" data-role="gate-secrets">secrets_scan: -</div>
<div class="gate-pill" data-role="gate-dynexec">dynamic_exec: -</div>
<div class="gate-pill" data-role="gate-arch">architecture_guard: -</div>
</div>
<div class="mt-3 text-xs font-mono text-brand-muted mb-2">Ledger event</div>
<pre class="text-[11px] leading-relaxed font-mono text-brand-strong whitespace-pre-wrap break-words" data-role="ledger-json"></pre>
<div class="mt-2 text-xs text-brand-muted" data-role="outcome">Select a case and evaluate policy outcomes.</div>
</div>
<div class="bg-brand-light border border-brand-border rounded-xl p-3">
<div class="flex items-center justify-between gap-3">
<div class="text-xs font-mono text-brand-muted">History</div>
<div class="text-xs text-brand-muted">Cyan = allow, red = block, violet = escalate, amber = warn</div>
</div>
<div class="mt-3 grid grid-cols-12 gap-1" data-role="history"></div>
</div>
</div>
</div>
</div>
<script>
(function () {
  const script = document.currentScript;
  const root = script ? script.closest('[data-infographic-section-id="i3-section-10-agent-execution-envelope"]') : null;
  if (!root || root.dataset.agentEnvelopeReady === '1') return;
  root.dataset.agentEnvelopeReady = '1';

  const sim = root.querySelector('[data-role="agent-sim"]');
  if (!sim) return;

  const caseButtons = Array.from(sim.querySelectorAll('[data-role="case"]'));
  const caseNoteEl = sim.querySelector('[data-role="case-note"]');
  const phasePills = Array.from(sim.querySelectorAll('[data-role="phase-pill"]'));
  const ttlSlider = sim.querySelector('[data-role="ttl-slider"]');
  const ttlValueEl = sim.querySelector('[data-role="ttl-value"]');
  const exceptionStateEl = sim.querySelector('[data-role="exception-state"]');

  const evaluateBtn = sim.querySelector('[data-role="evaluate"]');
  const exceptionBtn = sim.querySelector('[data-role="exception"]');
  const resetBtn = sim.querySelector('[data-role="reset"]');

  const selectedLabelEl = sim.querySelector('[data-role="selected-label"]');
  const verdictEl = sim.querySelector('[data-role="verdict"]');
  const actionEl = sim.querySelector('[data-role="action"]');
  const runEl = sim.querySelector('[data-role="run"]');

  const precedenceEl = sim.querySelector('[data-role="precedence"]');
  const gateScopeEl = sim.querySelector('[data-role="gate-scope"]');
  const gateSecretsEl = sim.querySelector('[data-role="gate-secrets"]');
  const gateDynexecEl = sim.querySelector('[data-role="gate-dynexec"]');
  const gateArchEl = sim.querySelector('[data-role="gate-arch"]');
  const ledgerJsonEl = sim.querySelector('[data-role="ledger-json"]');
  const outcomeEl = sim.querySelector('[data-role="outcome"]');
  const historyEl = sim.querySelector('[data-role="history"]');

  if (!caseButtons.length || !caseNoteEl || phasePills.length === 0 || !ttlSlider || !ttlValueEl || !exceptionStateEl ||
      !evaluateBtn || !exceptionBtn || !resetBtn || !selectedLabelEl || !verdictEl || !actionEl || !runEl ||
      !precedenceEl || !gateScopeEl || !gateSecretsEl || !gateDynexecEl || !gateArchEl || !ledgerJsonEl || !outcomeEl || !historyEl) return;

  const toInt = (v, fallback) => {
    const n = Number.parseInt(String(v), 10);
    return Number.isFinite(n) ? n : fallback;
  };
  const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));
  const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phaseDelay = reducedMotion ? 0 : 130;

  const CASES = {
    allowlisted_refactor: {
      label: 'Allowlisted Refactor',
      note: 'Low-risk refactor inside allowlisted scope.',
      missionId: 'mission/refactor/formatter-v3',
      paths: ['services/orders/src/formatter.ts'],
      findings: { scope: false, secrets: false, dynexec: false, architecture: false },
      policyVersion: '2.3.1'
    },
    protected_path_touch: {
      label: 'Protected Path Touch',
      note: 'Candidate touches immutable governance surfaces.',
      missionId: 'mission/refactor/ci-fastlane',
      paths: ['.github/workflows/main.yml'],
      findings: { scope: true, secrets: false, dynexec: false, architecture: false },
      policyVersion: '2.3.1'
    },
    hardcoded_secret: {
      label: 'Hardcoded Secret',
      note: 'Diff contains credential-like assignment pattern.',
      missionId: 'mission/refactor/auth-helper',
      paths: ['services/auth/src/token.ts'],
      findings: { scope: false, secrets: true, dynexec: false, architecture: false },
      policyVersion: '2.3.1'
    },
    architecture_change: {
      label: 'Architecture Change',
      note: 'Cross-module contract shift requires explicit human review.',
      missionId: 'mission/refactor/service-split',
      paths: ['services/orders/src/adapter.ts', 'services/payments/src/bridge.ts'],
      findings: { scope: false, secrets: false, dynexec: false, architecture: true },
      policyVersion: '2.3.1'
    }
  };

  const state = {
    selected: 'allowlisted_refactor',
    run: 0,
    exceptionDays: toInt(ttlSlider.value, 7),
    exceptionActiveUntil: null,
    last: null,
  };

  const passFail = (ok) => ok ? 'PASS' : 'FAIL';

  const applyGatePill = (el, label, pass) => {
    el.textContent = `${label}: ${passFail(pass)}`;
    el.classList.remove('is-pass', 'is-fail');
    el.classList.add(pass ? 'is-pass' : 'is-fail');
  };

  const setPhase = (phase) => {
    for (const pill of phasePills) {
      const active = pill.dataset.phase === phase;
      pill.dataset.active = active ? '1' : '0';
    }
  };

  const clearPhase = () => {
    for (const pill of phasePills) {
      pill.dataset.active = '0';
    }
  };

  const setCaseButtons = () => {
    for (const button of caseButtons) {
      const active = button.dataset.case === state.selected;
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    }
  };

  const appendHistory = (kind) => {
    const pill = document.createElement('span');
    const suffix = kind === 'allow' ? 'is-pass' : kind === 'warn' ? 'is-warn' : kind === 'escalate' ? 'is-escalate' : 'is-fail';
    pill.className = `attempt-pill ${suffix}`;
    historyEl.appendChild(pill);
    while (historyEl.children.length > 36) {
      historyEl.removeChild(historyEl.firstChild);
    }
  };

  const computeEvaluation = (selectedCase, withException) => {
    const gates = {
      scope: !selectedCase.findings.scope,
      secrets: !selectedCase.findings.secrets,
      dynexec: !selectedCase.findings.dynexec,
      architecture: !selectedCase.findings.architecture,
    };

    let verdict = 'ALLOW';
    let action = 'execute';
    let precedence = 'none';
    let historyKind = 'allow';

    if (!gates.secrets || !gates.dynexec) {
      verdict = 'BLOCK';
      action = 'block';
      precedence = 'security';
      historyKind = 'block';
    } else if (!gates.scope) {
      verdict = 'BLOCK';
      action = 'block';
      precedence = 'scope';
      historyKind = 'block';
    } else if (!gates.architecture) {
      precedence = 'architecture';
      if (withException) {
        verdict = 'WARN';
        action = 'time_bounded_exception';
        historyKind = 'warn';
      } else {
        verdict = 'ESCALATE';
        action = 'escalate_human_review';
        historyKind = 'escalate';
      }
    }

    const expiresAt = withException
      ? new Date(Date.now() + (state.exceptionDays * 24 * 60 * 60 * 1000)).toISOString().slice(0, 10)
      : null;

    return {
      gates,
      verdict,
      action,
      precedence,
      historyKind,
      withException,
      selectedCase,
      expiresAt,
    };

  };

  const renderFromState = (mode) => {
    const selectedCase = CASES[state.selected] || CASES.allowlisted_refactor;
    const preview = computeEvaluation(selectedCase, false);

    selectedLabelEl.textContent = selectedCase.label;
    caseNoteEl.textContent = selectedCase.note;
    ttlValueEl.textContent = String(state.exceptionDays);
    exceptionStateEl.textContent = state.exceptionActiveUntil ? `active until ${state.exceptionActiveUntil}` : 'none';

    if (mode === 'preview') {
      verdictEl.textContent = 'READY';
      verdictEl.style.color = '#b5b6bf';
      actionEl.textContent = `Predicted: ${preview.action}`;
      actionEl.style.color = '#b5b6bf';
      precedenceEl.textContent = preview.precedence;
      precedenceEl.style.color = '#b5b6bf';

      applyGatePill(gateScopeEl, 'scope_guard', preview.gates.scope);
      applyGatePill(gateSecretsEl, 'secrets_scan', preview.gates.secrets);
      applyGatePill(gateDynexecEl, 'dynamic_exec', preview.gates.dynexec);
      applyGatePill(gateArchEl, 'architecture_guard', preview.gates.architecture || preview.verdict !== 'ESCALATE');

      ledgerJsonEl.textContent = JSON.stringify({
        run: state.run,
        case_id: state.selected,
        mission_id: selectedCase.missionId,
        policy_version: selectedCase.policyVersion,
        status: 'ready'
      }, null, 2);
      outcomeEl.textContent = 'Select a case and evaluate policy outcomes.';
      runEl.textContent = String(state.run);
      clearPhase();
      return;
    }

    const result = state.last;
    if (!result) return;

    verdictEl.textContent = result.verdict;
    verdictEl.style.color = result.verdict === 'ALLOW' ? '#2ac3de' : result.verdict === 'WARN' ? '#facc15' : result.verdict === 'ESCALATE' ? '#bb9af7' : '#f7768e';
    actionEl.textContent = result.action;
    actionEl.style.color = verdictEl.style.color;
    precedenceEl.textContent = result.precedence;
    precedenceEl.style.color = result.precedence === 'none' ? '#b5b6bf' : verdictEl.style.color;

    applyGatePill(gateScopeEl, 'scope_guard', result.gates.scope);
    applyGatePill(gateSecretsEl, 'secrets_scan', result.gates.secrets);
    applyGatePill(gateDynexecEl, 'dynamic_exec', result.gates.dynexec);
    applyGatePill(gateArchEl, 'architecture_guard', result.gates.architecture || result.verdict !== 'ESCALATE');

    const ledger = {
      run: state.run,
      case_id: state.selected,
      mission_id: result.selectedCase.missionId,
      policy_version: result.selectedCase.policyVersion,
      changed_paths: result.selectedCase.paths,
      gates: {
        scope_guard: passFail(result.gates.scope),
        secrets_scan: passFail(result.gates.secrets),
        dynamic_exec_scan: passFail(result.gates.dynexec),
        architecture_guard: result.gates.architecture ? 'PASS' : (result.verdict === 'WARN' ? 'EXCEPTION' : 'ESCALATE')
      },
      precedence_hit: result.precedence,
      action: result.action,
      verdict: result.verdict,
      exception: result.withException ? {
        approved_by: 'human:platform-lead',
        expires_on: result.expiresAt
      } : null
    };

    ledgerJsonEl.textContent = JSON.stringify(ledger, null, 2);
    runEl.textContent = String(state.run);

    if (result.verdict === 'ALLOW') {
      outcomeEl.textContent = 'ALLOW: request satisfies all policy gates.';
    } else if (result.verdict === 'WARN') {
      outcomeEl.textContent = `WARN: exception granted; expires on ${result.expiresAt}.`;
    } else if (result.verdict === 'ESCALATE') {
      outcomeEl.textContent = 'ESCALATE: architecture policy requires explicit human review.';
    } else {
      outcomeEl.textContent = `BLOCK: ${result.precedence} policy failed at highest precedence.`;
    }
  };

  const runEvaluation = async (withException) => {
    const phases = ['compile', 'evaluate', 'decide', 'record'];
    for (const phase of phases) {
      setPhase(phase);
      if (phaseDelay > 0) await wait(phaseDelay);
    }
    const selectedCase = CASES[state.selected] || CASES.allowlisted_refactor;
    const result = computeEvaluation(selectedCase, withException);
    state.run += 1;
    state.last = result;
    if (withException) {
      state.exceptionActiveUntil = result.expiresAt;
    }
    appendHistory(result.historyKind);
    renderFromState('result');
  };

  for (const button of caseButtons) {
    button.addEventListener('click', () => {
      const key = button.dataset.case;
      if (!key || !CASES[key]) return;
      state.selected = key;
      setCaseButtons();
      renderFromState('preview');
    });
  }

  ttlSlider.addEventListener('input', () => {
    state.exceptionDays = toInt(ttlSlider.value, state.exceptionDays);
    renderFromState('preview');
  });

  evaluateBtn.addEventListener('click', () => {
    runEvaluation(false);
  });

  exceptionBtn.addEventListener('click', () => {
    const selectedCase = CASES[state.selected] || CASES.allowlisted_refactor;
    if (!selectedCase.findings.architecture || selectedCase.findings.scope || selectedCase.findings.secrets || selectedCase.findings.dynexec) {
      outcomeEl.textContent = 'Exception is only valid for architecture-review scenarios after lower-precedence gates pass.';
      return;
    }
    runEvaluation(true);
  });

  resetBtn.addEventListener('click', () => {
    state.selected = 'allowlisted_refactor';
    state.run = 0;
    state.exceptionDays = toInt(ttlSlider.value, 7);
    state.exceptionActiveUntil = null;
    state.last = null;
    historyEl.innerHTML = '';
    setCaseButtons();
    renderFromState('preview');
  });

  setCaseButtons();
  renderFromState('preview');
})();
</script>
</section>

            </section></div>
